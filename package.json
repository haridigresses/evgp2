{
  "name": "evgp2",
  "version": "0.1.1",
  "description": "EV/GP₂: value a company as a multiple on two-year-forward gross profit, with growth that decays.",
  "license": "MIT",
  "author": "haridigresses",
  "repository": { "type": "git", "url": "git+https://github.com/haridigresses/evgp2.git" },
  "keywords": ["valuation", "gross-profit", "enterprise-value", "multiples", "finance"],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist", "src"],
  "engines": { "node": ">=22.18" },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/fix-dts.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3"
  }
}
